{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sylvercode/dm-assistant/skills/vault-orientation/assets/dmassist.schema.json",
  "title": "DM Assistant Vault Configuration Profile, Version 1",
  "description": "Validates the normalized version-1 profile structure and values. It does not parse YAML, apply defaults, or perform vault/runtime checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Application-level .dmassist.yaml profile version."
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "default": {
        "adventures": "Adventures",
        "lore": "Lore",
        "monsters_stats": "Monsters Stats",
        "rules": "Rules",
        "sessions": "Sessions",
        "handouts": "Handouts"
      },
      "properties": {
        "adventures": {
          "$ref": "#/$defs/nonEmptyString",
          "default": "Adventures"
        },
        "lore": {
          "$ref": "#/$defs/nonEmptyString",
          "default": "Lore"
        },
        "monsters_stats": {
          "$ref": "#/$defs/nonEmptyString",
          "default": "Monsters Stats"
        },
        "rules": {
          "$ref": "#/$defs/nonEmptyString",
          "default": "Rules"
        },
        "sessions": {
          "$ref": "#/$defs/nonEmptyString",
          "default": "Sessions"
        },
        "handouts": {
          "$ref": "#/$defs/nonEmptyString",
          "default": "Handouts"
        },
        "custom": {
          "type": "object",
          "default": {},
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              {
                "not": {
                  "enum": [
                    "adventures",
                    "lore",
                    "monsters_stats",
                    "rules",
                    "sessions",
                    "handouts"
                  ]
                }
              }
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "description"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/nonEmptyString",
                "description": "Vault-relative directory path; filesystem and vault-boundary checks are runtime responsibilities."
              },
              "description": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      }
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note"
      ],
      "properties": {
        "note": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Vault-relative path to the active party note; file checks are runtime responsibilities."
        }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "description": "When omitted, runtime resolution uses session_section mode with the Preparation heading. When present, mode is required; an empty object is invalid.",
      "default": {
        "mode": "session_section",
        "heading": "Preparation"
      },
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "session_section",
            "separate_folder"
          ]
        },
        "heading": {
          "$ref": "#/$defs/nonEmptyString",
          "default": "Preparation"
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Vault-relative directory path; filesystem and vault-boundary checks are runtime responsibilities."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "session_section"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "path"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "separate_folder"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ],
            "not": {
              "required": [
                "heading"
              ]
            }
          }
        }
      ]
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Vault-relative Markdown file path; file checks are runtime responsibilities."
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "adventure": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "character": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "handout": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "location": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "monster": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "party": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "persona": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "session": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "custom": {
          "type": "object",
          "default": {},
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              {
                "not": {
                  "enum": [
                    "adventure",
                    "character",
                    "handout",
                    "location",
                    "monster",
                    "party",
                    "persona",
                    "rule",
                    "session"
                  ]
                }
              }
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/nonEmptyString",
            "description": "Vault-relative Markdown template path; template availability and validity are runtime responsibilities."
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
